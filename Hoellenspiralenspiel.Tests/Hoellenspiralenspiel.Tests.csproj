<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>default</LangVersion>
        <RootNamespace>Hoellenspiralenspiel.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Der Kern wird als Quelltext eingebunden, nicht als Verweis auf das Godot-Projekt.
            Hängt eine Datei unter Scripts/Core von Godot ab, schlägt dieser Build fehl.
        -->
        <Compile Include="..\Scripts\Core\**\*.cs" LinkBase="Core" />
        <Compile Include="..\Enums\CombatStat.cs" Link="Enums\CombatStat.cs" />
        <Compile Include="..\Enums\ItemSlot.cs" Link="Enums\ItemSlot.cs" />
        <Compile Include="..\Enums\ModificationType.cs" Link="Enums\ModificationType.cs" />
        <Compile Include="..\Scripts\Utils\CommandResolver.cs" Link="Utils\CommandResolver.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    </ItemGroup>

</Project>
